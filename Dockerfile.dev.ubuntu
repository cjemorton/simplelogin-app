####################
# Stage 1: Build frontend assets with dev dependencies
####################
FROM node:20-alpine AS frontend-builder

WORKDIR /code

# Copy package files
COPY ./static/package*.json /code/static/

# Install all npm dependencies including dev dependencies
RUN cd /code/static && npm ci

####################
# Stage 2: Development environment with all tools
####################
FROM ubuntu:24.04 AS development

# Build arguments
ARG UV_VERSION="0.8.18"
ARG UV_HASH="59ad1a1809fa47019b86cf339fff161cb7b00ad3d8d42354eea57d0d91aeb44c"

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CMAKE_POLICY_VERSION_MINIMUM=3.5 \
    FLASK_ENV=development \
    FLASK_DEBUG=1 \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /code

# Install all development dependencies including build tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        ca-certificates \
        gcc \
        g++ \
        python3-dev \
        git \
        libre2-dev \
        build-essential \
        pkg-config \
        cmake \
        ninja-build \
        clang \
        postgresql-client \
        libpq-dev \
        vim \
        wget \
        netcat-openbsd \
        bash \
    && rm -rf /var/lib/apt/lists/*

# Install uv for faster Python package management
RUN curl -sSL "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" > uv.tar.gz && \
    echo "${UV_HASH}  uv.tar.gz" | sha256sum -c - && \
    tar xf uv.tar.gz -C /tmp/ && \
    mv /tmp/uv-x86_64-unknown-linux-gnu/uv /usr/local/bin/uv && \
    mv /tmp/uv-x86_64-unknown-linux-gnu/uvx /usr/local/bin/uvx && \
    rm -rf /tmp/uv* uv.tar.gz

# Copy dependency files
COPY pyproject.toml uv.lock .python-version ./

# Install Python and all dependencies including dev dependencies
RUN uv python install $(cat .python-version) && \
    uv sync --locked --all-extras

# Copy application code (in dev, we typically mount this as a volume)
COPY . .

# Copy frontend node_modules from builder
COPY --from=frontend-builder /code/static/node_modules /code/static/node_modules

# Create necessary directories
RUN mkdir -p /code/static/upload /code/local_data

# Set PATH to use virtual environment
ENV PATH="/code/.venv/bin:$PATH"

# Expose application port
EXPOSE 7777

# Expose debugger port (for Python debuggers like debugpy)
EXPOSE 5678

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:7777/health || exit 1

# Development command with auto-reload
# In practice, this is often overridden in docker-compose for specific needs
CMD ["flask", "run", "--host=0.0.0.0", "--port=7777", "--reload", "--debug"]
